{
  "name": "@sites/images",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev -p 3012",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . ../../packages/shell/src",
    "format:check": "prettier --check . ../../packages/shell/src",
    "check": "npm run lint && npm run lint:shell && npm run typecheck && npm run test && npm run format:check",
    "lint:shell": "eslint ../../packages/shell/src --ext .ts,.tsx --max-warnings 0"
  },
  "dependencies": {
    "@sites/shell": "*",
    "next": "^14.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
