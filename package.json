{
  "name": "sites-lab",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:tools": "npm run dev -w @sites/tools",
    "build:tools": "npm run build -w @sites/tools",
    "check:tools": "npm run check -w @sites/tools",
    "dev:calc": "npm run dev -w @sites/calc",
    "build:calc": "npm run build -w @sites/calc",
    "check:calc": "npm run check -w @sites/calc",
    "check": "npm run check:tools && npm run check:calc"
  },
  "engines": {
    "node": ">=20"
  }
}
